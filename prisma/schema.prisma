generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  role_key    String    @unique
  description String?
  status      Int       @default(1)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
}